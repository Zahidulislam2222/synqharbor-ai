# Optional canonical origin; parsed by src/config/ui.ts. No provider keys reach the frontend.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_API_PREFIX=/api/v1

# Backend: copy these SH_ settings to backend/.env. Use a freshly generated secret.
# SQLite is for single-process local development; PostgreSQL is the deployment target.
SH_DATABASE_URL=sqlite:///runtime/control.sqlite
SH_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SH_PUBLIC_ORIGIN=http://localhost:8000
SH_SECURE_COOKIES=false
# Close self-registration on an operator-managed deployment; provision accounts locally.
SH_REGISTRATION_ENABLED=true
SH_COOKIE_NAME=synqharbor-local
SH_SESSION_HOURS=24
SH_INVITE_HOURS=24
SH_DATABASE_POOL_SIZE=5
SH_DATABASE_MAX_OVERFLOW=5
SH_DATABASE_POOL_TIMEOUT=15
SH_SQLITE_TIMEOUT=10
SH_API_PREFIX=/api/v1
SH_API_TITLE=SynqHarbor API
SH_RELEASE=0.3.0
SH_MAX_BODY_BYTES=65536
SH_LIST_LIMIT=100
SH_MAX_TASKS=1000
SH_MAX_MESSAGES=1000
SH_RATE_WINDOW_SECONDS=600
SH_AUTH_RATE_LIMIT=30
SH_CONTACT_RATE_LIMIT=5
# Allows normal identity-checked control polling plus interactive requests.
SH_SESSION_RATE_LIMIT=900
SH_WRITE_RATE_LIMIT=120
SH_RETENTION_DAYS=30
SH_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Use an installed loopback Ollama service. No cloud models or paid fallback.
# SH_INFERENCE_URL=http://127.0.0.1:11434
# Optional curl executable in the service's OS namespace, for WSL to Windows loopback.
# SH_INFERENCE_BRIDGE=/path/to/curl
# SH_BUILDER_MODEL=installed-local-model
# SH_CODE_BUILDER_MODEL=installed-local-coding-model
# SH_REVIEWER_MODEL=installed-local-model
# Pin each local model's complete digest after inspecting the installed inventory.
SH_MODEL_DIGESTS={}
SH_INFERENCE_TIMEOUT=180
SH_INFERENCE_MAX_BYTES=131072
SH_INFERENCE_TOKENS=2048
SH_INFERENCE_CONTEXT=8192
# Match CPU execution threads to the service/container allocation; qualify actual latency.
SH_INFERENCE_THREADS=2
SH_INFERENCE_TEMPERATURE=0
SH_RUN_LEASE_SECONDS=900
SH_WORKER_POLL_SECONDS=2
SH_MAX_RUN_ATTEMPTS=2
SH_MAX_BUILDER_ITERATIONS=2
SH_MAX_RUNS=1000
# Optional absolute paths; defaults for maintained data are owned by Settings.
# SH_DATA_DIRECTORY=/path/to/backend/data
# SH_FRONTEND_DIRECTORY=/path/to/out
# Coding remains unavailable until the gVisor runtime is installed and qualified.
# SH_RUNNER_BINARY=/path/to/runsc
# SH_RUNNER_ROOTFS=/path/to/prepared/rootfs
# SH_RUNNER_DIRECTORY=/path/to/private/job-state
SH_RUNNER_TIMEOUT=15
SH_RUNNER_CLEANUP_TIMEOUT=10
SH_RUNNER_MEMORY_BYTES=268435456
SH_RUNNER_OUTPUT_BYTES=8192
SH_RUNNER_CPU_SECONDS=3
SH_RUNNER_PROCESS_LIMIT=32
SH_GIT_BINARY=git
SH_GIT_TIMEOUT=120
# Optional dedicated, disposable local test repository with security hooks installed.
# SH_RELEASE_REPOSITORY=/path/to/private/test-repository
SH_REPOSITORY_TARGETS={}
SH_REPOSITORY_CONTEXT_BYTES=12000
# SH_MIGRATION_DATABASE_URL=postgresql+psycopg://migration-user:configure-secret@localhost/database
SH_MAX_SOURCES=100
SH_MAX_ACTIVE_RUNS=10
SH_SOURCE_CONTEXT_BYTES=8000
SH_INFERENCE_THINK=false
